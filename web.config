<?xml version="1.0" encoding="UTF-8"?>
<!-- web.config — Production Server Configuration for IIS (Windows Hosting) -->
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- 1. Sitemap Rewrites -->
                <rule name="Sitemap Index" stopProcessing="true">
                    <match url="^sitemap\.xml$" />
                    <action type="Rewrite" url="api/sitemap_index.php" />
                </rule>
                <rule name="Sitemap Main" stopProcessing="true">
                    <match url="^sitemap-main\.xml$" />
                    <action type="Rewrite" url="api/sitemap_main.php" />
                </rule>
                <rule name="Sitemap Categories" stopProcessing="true">
                    <match url="^sitemap-categories\.xml$" />
                    <action type="Rewrite" url="api/sitemap_categories.php" />
                </rule>
                <rule name="Sitemap Listings" stopProcessing="true">
                    <match url="^sitemap-listings\.xml$" />
                    <action type="Rewrite" url="api/sitemap_listings.php" />
                </rule>

                <!-- 2. Redirect index.html to index.php -->
                <rule name="Redirect index.html" stopProcessing="true">
                    <match url="^index\.html$" />
                    <action type="Redirect" url="/index.php" redirectType="Permanent" />
                </rule>

                <!-- 3. SPA Fallback (Route virtual paths to index.php) -->
                <rule name="SPA Fallback Rule" stopProcessing="true">
                    <match url=".*" />
                    <conditions logicalGrouping="MatchAll">
                        <!-- Skip existing physical files and folders -->
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                        <add input="{REQUEST_DIRNAME}" matchType="IsDirectory" negate="true" />
                        <!-- Skip API calls -->
                        <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>
        
        <!-- Mime Map Configuration (Ensures support for modern formats) -->
        <staticContent>
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
            <remove fileExtension=".webp" />
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <remove fileExtension=".woff2" />
            <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
        </staticContent>
    </system.webServer>
</configuration>
