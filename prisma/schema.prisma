generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model car_makes {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
}

model car_models {
  id         Int      @id @default(autoincrement())
  name       String
  make_id    Int?
  created_at DateTime @default(now())

  @@index([make_id])
}

model car_types {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
}

model categories {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
}

model category {
  CategoryID       Int       @id @default(autoincrement())
  ParentCategoryID Int?
  CategoryName     String
  Slug             String?
  Icon             String?
  Description      String?
  SortOrder        Int?      @default(0)
  IsActive         Boolean?  @default(true)
  CreatedAt        DateTime? @default(now())
  template_config  String?

  @@index([IsActive])
  @@index([ParentCategoryID])
}

model categoryattribute {
  AttributeID   Int      @id @default(autoincrement())
  CategoryID    Int
  AttributeName String
  AttributeType String
  IsRequired    Boolean? @default(false)

  @@index([CategoryID])
}

model categoryattributeoption {
  OptionID    Int    @id @default(autoincrement())
  AttributeID Int
  OptionValue String

  @@index([AttributeID])
}

model drivetrains {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
}

model email_settings {
  id            Int      @id @default(autoincrement())
  setting_key   String   @unique
  setting_value String
  updated_at    DateTime @default(now())
}

model fuel_types {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
}

model listing_seo {
  id             Int      @id @default(autoincrement())
  listing_id     Int      @unique
  meta_title     String?
  meta_desc      String?
  keywords       String?
  image_alt_text String?
  focus_keyword  String?
  seo_score      Int?     @db.SmallInt
  updated_at     DateTime @default(now())
}

model listings {
  id                   Int       @id @default(autoincrement())
  title                String
  price                Decimal
  category             String
  location             String
  time                 String?
  image                String?
  is_featured          Boolean?  @default(false)
  description          String?
  views                Int?      @default(0)
  saves                Int?      @default(0)
  inquiries            Int?      @default(0)
  user_id              Int?
  created_at           DateTime? @default(now())
  contact_email        String?
  contact_phone        String?
  postal_code          String?
  is_top_ad            Boolean?  @default(false)
  is_highlighted       Boolean?  @default(false)
  is_urgent            Boolean?  @default(false)
  is_home_gallery      Boolean?  @default(false)
  promotion_expires_at DateTime?
  youtube_link         String?
  facebook_link        String?
  price_type           String?   @default("amount")
  parent_id            Int?
  latitude             Decimal?
  longitude            Decimal?

  @@index([parent_id])
  @@index([user_id])
}

model main_menu_master {
  id         Int      @id @default(autoincrement())
  name       String
  icon       String?
  sort_order Int?     @default(0)
  is_active  Boolean? @default(true)
  created_at DateTime @default(now())
}

model messages {
  id          Int       @id @default(autoincrement())
  listing_id  Int
  sender_id   Int
  receiver_id Int
  message     String
  sender_name String?
  created_at  DateTime? @default(now())
  is_read     Boolean?  @default(false)
}

model options {
  id           Int      @id @default(autoincrement())
  option_type  String
  option_value String
  created_at   DateTime @default(now())
}

model price_options {
  id         Int      @id @default(autoincrement())
  name       String
  option_key String   @unique
  sort_order Int?     @default(0)
  is_active  Boolean? @default(true)
  created_at DateTime @default(now())
}

model seo_settings {
  setting_key   String   @id
  setting_value String
  updated_at    DateTime @default(now())
}

model transactions {
  id            Int      @id @default(autoincrement())
  user_id       Int
  listing_id    Int
  ticket        String
  receipt_id    String?
  amount        Decimal
  response_code String?
  payment_type  String?
  promotions    String
  status        String?  @default("pending")
  created_at    DateTime @default(now())

  @@index([listing_id])
  @@index([user_id])
}

model users {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  password           String
  role               String?   @default("user")
  avatar             String?
  join_date          DateTime? @default(now())
  phone              String?   @default("+1 (555) 123-4567")
  is_verified        Boolean?  @default(false)
  verification_token String?
  reset_token        String?
  reset_token_expiry DateTime?
}

model vehicle_types {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
}

model promotion_pricing {
  id             Int       @id @default(autoincrement())
  promotion_type String
  duration_days  Int
  price          Decimal
  is_active      Boolean?  @default(true)
  created_at     DateTime? @default(now())

  @@unique([promotion_type, duration_days])
}
